# Local Azurite only. Never configure a connection string in production.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Azure-hosted workloads use this endpoint with their managed identity.
AZURE_STORAGE_TABLES_ENDPOINT=https://stbordchamp164164.table.core.windows.net
AZURE_STORAGE_COMMODITIES_TABLE=ReferenceData
AZURE_STORAGE_ORGANIZATIONS_TABLE=Organizations
AZURE_STORAGE_USER_DIRECTORY_TABLE=UserDirectory
AZURE_STORAGE_INVENTORY_TABLE=Inventory
AZURE_STORAGE_PRODUCTION_UNITS_TABLE=ProductionUnits
AZURE_STORAGE_INSPECTIONS_TABLE=Inspections
AZURE_STORAGE_WAREHOUSE_RECEIPTS_TABLE=WarehouseReceipts
AZURE_STORAGE_TRADING_TABLE=Trading
AZURE_STORAGE_SETTLEMENTS_TABLE=Settlements
AZURE_STORAGE_DELIVERIES_TABLE=Deliveries
AZURE_STORAGE_DISPUTES_TABLE=Disputes
AZURE_STORAGE_COMPLIANCE_TABLE=Compliance
AZURE_STORAGE_LINEAGE_TABLE=Lineage
AZURE_STORAGE_RISK_TABLE=Risk
AZURE_STORAGE_INTEGRATIONS_TABLE=Integrations
WEBHOOK_SIGNING_MASTER_SECRET=replace-with-at-least-24-characters
ESCROW_WEBHOOK_SECRET=replace-with-at-least-16-characters

# BordChamp-managed authentication (email + password + TOTP).
# Generate a 2048-bit RSA key pair for signing access tokens (RS256).
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl rsa -pubout -in jwt-private.pem -out jwt-public.pem
# Then paste the PEMs on a SINGLE line with \n escapes, or set both to a path via secret store.
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# 32 random bytes, base64-encoded. AES-256-GCM encrypts stored TOTP secrets at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET_ENCRYPTION_KEY=

# 32 random bytes, base64-encoded. Peppers the HMAC-SHA256 hash of refresh tokens at rest.
AUTH_REFRESH_TOKEN_PEPPER=

# 32 random bytes, base64-encoded. Signs short-lived enrollment / MFA challenge JWTs (HS256).
AUTH_CHALLENGE_KEY=

# Microsoft Authenticator (or any RFC 6238 authenticator app) enrolls the TOTP secret
# during registration. Recovery codes are shown once and stored as SHA-256 hashes.