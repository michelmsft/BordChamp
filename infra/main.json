{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "9730025890104497565"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "southafricanorth",
      "metadata": {
        "description": "Azure region for the BordChamp resource group and storage account."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "bordchamp-rg",
      "metadata": {
        "description": "Resource group containing BordChamp data resources."
      }
    },
    "storageAccountName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Globally unique StorageV2 account name."
      }
    },
    "tableDataPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra object ID granted access to BordChamp Table data for bootstrap and development."
      }
    },
    "storageSkuName": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS"
      ],
      "metadata": {
        "description": "Storage redundancy. Standard_LRS is the cost-conscious pilot default."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2022-09-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": {
        "application": "BordChamp",
        "environment": "pilot",
        "managedBy": "Bicep",
        "dataClassification": "business"
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "bordchamp-storage",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "storageAccountName": {
            "value": "[parameters('storageAccountName')]"
          },
          "storageSkuName": {
            "value": "[parameters('storageSkuName')]"
          },
          "tableDataPrincipalId": {
            "value": "[parameters('tableDataPrincipalId')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "11614043861753943255"
            }
          },
          "parameters": {
            "location": {
              "type": "string",
              "metadata": {
                "description": "Azure region for the storage account."
              }
            },
            "storageAccountName": {
              "type": "string",
              "metadata": {
                "description": "Globally unique StorageV2 account name."
              }
            },
            "storageSkuName": {
              "type": "string",
              "metadata": {
                "description": "Storage redundancy SKU."
              }
            },
            "tableDataPrincipalId": {
              "type": "string",
              "metadata": {
                "description": "Microsoft Entra object ID granted Storage Table Data Contributor."
              }
            }
          },
          "variables": {
            "tableNames": [
              "ReferenceData",
              "Organizations",
              "UserDirectory",
              "Inventory",
              "ProductionUnits",
              "Inspections",
              "WarehouseReceipts",
              "Trading",
              "Settlements",
              "Deliveries",
              "Disputes",
              "Compliance",
              "Lineage",
              "Risk",
              "Integrations"
            ],
            "storageTableDataContributorRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '0a9a7e1f-b9d0-4cc4-a60d-0319b160aaa3')]"
          },
          "resources": [
            {
              "type": "Microsoft.Storage/storageAccounts",
              "apiVersion": "2026-04-01",
              "name": "[parameters('storageAccountName')]",
              "location": "[parameters('location')]",
              "sku": {
                "name": "[parameters('storageSkuName')]"
              },
              "kind": "StorageV2",
              "properties": {
                "accessTier": "Hot",
                "allowBlobPublicAccess": false,
                "allowCrossTenantReplication": false,
                "allowSharedKeyAccess": false,
                "defaultToOAuthAuthentication": true,
                "isHnsEnabled": false,
                "minimumTlsVersion": "TLS1_2",
                "publicNetworkAccess": "Disabled",
                "supportsHttpsTrafficOnly": true,
                "networkAcls": {
                  "bypass": "AzureServices",
                  "defaultAction": "Allow"
                }
              },
              "tags": {
                "application": "BordChamp",
                "environment": "pilot",
                "dataService": "AzureTableStorage"
              }
            },
            {
              "type": "Microsoft.Storage/storageAccounts/tableServices",
              "apiVersion": "2026-04-01",
              "name": "[format('{0}/{1}', parameters('storageAccountName'), 'default')]",
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ]
            },
            {
              "copy": {
                "name": "tables",
                "count": "[length(variables('tableNames'))]"
              },
              "type": "Microsoft.Storage/storageAccounts/tableServices/tables",
              "apiVersion": "2023-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('storageAccountName'), 'default', variables('tableNames')[copyIndex()])]",
              "properties": {},
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts/tableServices', parameters('storageAccountName'), 'default')]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), parameters('tableDataPrincipalId'), variables('storageTableDataContributorRoleDefinitionId'))]",
              "properties": {
                "principalId": "[parameters('tableDataPrincipalId')]",
                "principalType": "User",
                "roleDefinitionId": "[variables('storageTableDataContributorRoleDefinitionId')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
              ]
            }
          ],
          "outputs": {
            "storageAccountName": {
              "type": "string",
              "value": "[parameters('storageAccountName')]"
            },
            "storageAccountResourceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
            },
            "tableEndpoint": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2026-04-01').primaryEndpoints.table]"
            },
            "tableNames": {
              "type": "array",
              "value": "[variables('tableNames')]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'bordchamp-storage'), '2025-04-01').outputs.storageAccountName.value]"
    },
    "tableEndpoint": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'bordchamp-storage'), '2025-04-01').outputs.tableEndpoint.value]"
    },
    "storageAccountResourceId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'bordchamp-storage'), '2025-04-01').outputs.storageAccountResourceId.value]"
    }
  }
}